<% humor = Fuba.Cuidado.humor(@fuba) %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @fuba.nome %></title>
  <style>
    :root {
      --fundo: #1a1023;
      --cartao: #241533;
      --rosa: #ff7edb;
      --roxo: #b98cff;
      --ciano: #7ef9ff;
      --alerta: #ff5c6c;
      --texto: #f2e9ff;
      --apagado: #8f7ba8;
    }

    * { box-sizing: border-box; margin: 0; }

    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: var(--fundo);
      color: var(--texto);
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
    }

    main {
      background: var(--cartao);
      border: 1px solid var(--roxo);
      border-radius: 16px;
      padding: 2rem;
      width: min(90vw, 340px);
      text-align: center;
    }

    .carinha {
      font-size: 2rem;
      color: var(--rosa);
      white-space: pre;
    }

    h1 { font-size: 1.1rem; margin: 0.5rem 0 0.25rem; }

    .humor {
      color: var(--apagado);
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .medidores {
      text-align: left;
      font-size: 0.8rem;
      display: grid;
      gap: 0.4rem;
      margin-bottom: 1.5rem;
    }

    .medidor { display: flex; justify-content: space-between; }

    .barra { color: var(--ciano); letter-spacing: 2px; }
    .barra.baixa { color: var(--alerta); }

    .acoes {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }

    button {
      font: inherit;
      font-size: 0.8rem;
      padding: 0.6rem;
      background: transparent;
      color: var(--rosa);
      border: 1px solid var(--rosa);
      border-radius: 8px;
      cursor: pointer;
    }

    button:hover { background: var(--rosa); color: var(--fundo); }
  </style>
</head>
<body>
  <main>
    <p class="carinha"><%= Fuba.Humor.carinha(humor) %></p>
    <h1><%= @fuba.nome %></h1>
    <p class="humor"><%= FubaWeb.Tela.frase(humor) %></p>

    <div class="medidores">
      <div class="medidor">
        <span>biscoito</span>
        <span class="barra <%= if @fuba.biscoito <= 1, do: "baixa" %>"><%= FubaWeb.Tela.barrinha(@fuba.biscoito) %></span>
      </div>
      <div class="medidor">
        <span>cafeína</span>
        <span class="barra <%= if @fuba.cafeina <= 1, do: "baixa" %>"><%= FubaWeb.Tela.barrinha(@fuba.cafeina) %></span>
      </div>
      <div class="medidor">
        <span>carinho</span>
        <span class="barra <%= if @fuba.carinho <= 1, do: "baixa" %>"><%= FubaWeb.Tela.barrinha(@fuba.carinho) %></span>
      </div>
      <div class="medidor">
        <span>energia</span>
        <span class="barra <%= if @fuba.energia <= 1, do: "baixa" %>"><%= FubaWeb.Tela.barrinha(@fuba.energia) %></span>
      </div>
    </div>

    <div class="acoes">
      <button>🍪 biscoito</button>
      <button>☕ café</button>
      <button>🫶 cafuné</button>
      <button>🍃 espaço</button>
    </div>
  </main>
</body>
</html>
